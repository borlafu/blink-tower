# Runtime environment for the docker-compose recipe.
#
#   cp .env.docker.example .env.docker
#
# .env.docker is gitignored. Never commit real credentials, and never bake them
# into the image — compose passes this file at runtime.

# Your Blink account. The values below are placeholders that let the app boot for
# verification: it will start, serve the UI and report "not authenticated"
# instead of contacting Blink with real credentials.
BLINK_USERNAME=you@example.com
BLINK_PASSWORD=replace-me

# --- Set by the image; override only if you know why ---

# Loopback-only, because the access gate refuses anything else and Caddy shares
# this container's network namespace.
# HOST=127.0.0.1
# PORT=8000

# Inside the container: /data is a named volume (survives restarts), /tmp/hls is
# a tmpfs (disposable).
# BLINK_CREDS_PATH=/data/blink_creds.json
# HLS_DIR=/tmp/hls

# Optional tunables, same as the top-level .env.example.
# SNAPSHOT_MIN_INTERVAL_SECONDS=2
# LIVEVIEW_MAX_SECONDS=280
