# Copy this file to .env and fill in your Blink account credentials.
# NEVER commit the real .env — it is gitignored.

# Blink account (the email + password you use in the Blink app).
BLINK_USERNAME=you@example.com
BLINK_PASSWORD=your-blink-password

# --- Optional tunables (sensible defaults applied if omitted) ---

# Protective floor (seconds) between forced captures per camera. The refresh
# rate is chosen in the UI; this only stops it going faster than is safe.
# SNAPSHOT_MIN_INTERVAL_SECONDS=2

# Hard cap for a single live-view session (Blink itself caps ~5 min).
# LIVEVIEW_MAX_SECONDS=280

# Where the cached Blink session token is stored (gitignored).
# BLINK_CREDS_PATH=blink_creds.json

# Temp dir for HLS segments (gitignored).
# HLS_DIR=hls_tmp

# Bind address / port. Leave HOST as 127.0.0.1.
#
# The app refuses any request that did not come from this machine, so changing
# HOST does not make it reachable from your phone or tablet — it only makes the
# socket listen more widely. To reach it from another device, put a reverse proxy
# or VPN in front of it: see deploy/README.md for Caddy (LAN) and Tailscale
# (remote) recipes. Authentication is that layer's job; this app has no login.
# HOST=127.0.0.1
# PORT=8000
